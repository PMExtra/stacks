# Copy to .env for the latest RedApp.
# Optional TAG selects the image version.
# Compose also passes this file to the container; omit unrelated sensitive values.
# These are application variable names, passed unchanged (no extra prefix).
# All settings are optional. Values below match the application defaults.

# Published HTTP(S) origin without a subpath. Admin override takes precedence;
# empty/unset falls back to a safe request origin when no admin override exists.
REDAPP_PUBLIC_URL=

# Restrict accepted domains at the reverse proxy. No application Host allowlist.

# Trusted inbound proxy CIDRs only, comma-separated; empty trusts no proxy.
# Use verified /32 IPv4 or /128 IPv6 peers where possible, never public ranges.
REDAPP_TRUSTED_PROXIES=

# Changing these also requires matching proxy routing and volume mount changes.
REDAPP_LISTEN=:8080
REDAPP_DATA=/var/lib/redapp

# Optional limits; omit to keep application defaults.
# Writers/readers are positive integers: writers 1..1024; readers 1..65536.
REDAPP_MAX_WRITERS=16
REDAPP_MAX_READERS=512
# Per-artifact size accepts go-humanize units or bytes; range 1 byte..1TiB.
# GiB is binary (1024^3 bytes); GB is decimal (1000^3 bytes).
REDAPP_MAX_ARTIFACT_BYTES=4GiB

# REDAPP_CONFIG may select an explicitly mounted YAML/JSON file. Omit by default:
# missing /etc/redapp/config.yaml is allowed; a missing selected file is an error.
