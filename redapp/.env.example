# Optional: pin a release instead of the default latest tag.
# TAG=v0.2.0

# Replace with the external origin. Subpaths are unsupported.
REDAPP_PUBLIC_URL=https://codex.example.internal

# Optional: also uncomment REDAPP_TRUSTED_PROXIES in compose.yaml.
# Set only verified proxy peer IP/CIDR(s), comma-separated; prefer /32 for IPv4
# or /128 for IPv6. By default no forwarded headers are trusted.
# REDAPP_TRUSTED_PROXIES=
