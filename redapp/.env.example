TAG=v0.1.0

# Replace with the external origin. Subpaths are unsupported.
REDAPP_PUBLIC_URL=https://codex.example.internal

# Empty means no forwarded headers are trusted. Set only the actual proxy
# peer IP/CIDR(s), comma-separated; prefer /32 for IPv4 or /128 for IPv6.
REDAPP_TRUSTED_PROXIES=

# Host port used only by optional/compose.expose.yaml (loopback binding).
REDAPP_PORT=8080
