# Distribution tag; use a reviewed version tag for controlled upgrades.
TAG=ubuntu-noble
# Required: choose a name unique within the repository or organization.
RUNNER_NAME=
# repo requires REPO_URL; org requires ORG_NAME (organization login, not URL).
RUNNER_SCOPE=repo
REPO_URL=
ORG_NAME=
# Obtain a short-lived registration token for the selected scope before first start.
# Remove this value after successful registration; the config volume holds identity.
RUNNER_TOKEN=
# Custom scheduling label, in addition to self-hosted, OS and architecture labels.
LABELS=dev
# HTTP proxy URLs reachable FROM the container, e.g. http://proxy.example.test:3128.
# https_proxy also uses http:// for an HTTP CONNECT proxy. Empty means direct access.
http_proxy=
https_proxy=
# Add actual internal database/service hostnames; do not put GitHub here if it needs proxy.
no_proxy=localhost,127.0.0.1
